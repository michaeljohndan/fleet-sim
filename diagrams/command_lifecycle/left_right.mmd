        R["render views, fixed key order<br/><i>serialization views</i>"]
        E["error line"]
    end
    IN --> P
    P -->|malformed| E
    P --> Q
    Q -->|"get_state"| R
    Q -->|"get_state_at(T)"| H
    Q -->|"mutating command"| V
