flowchart LR
    subgraph shell["Imperative shell (main.rs)"]
        IN["stdin line"]
        OUT["stdout line"]
    end
    subgraph core["Functional core (lib.rs handle_line → protocol, sim)"]
        P["parse → Command<br/><i>Command pattern</i>"]
        Q{"query?"}
